// نموذج قاعدة البيانات — يستعمل SQLite محليا. للنشر (Vercel) بدّل provider لـ "postgresql"
// وحط DATABASE_URL ديال Supabase/Neon فـ .env
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  edition     String
  description String
  price       Int
  stock       Int      @default(10)
  image       String?
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  wilaya        String
  address       String
  status        String      @default("nouvelle") // nouvelle, confirmee, expediee, livree, annulee
  total         Int
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}
